# VELORA EDIT — affiliate configuration
# Copy to .env (never commit .env)

# Affiliate mode: mock | production
AFFILIATE_MODE=mock

# Site
PUBLIC_SITE_URL=https://velora-edit.pages.dev
PUBLIC_CURRENCY=EUR

# Price display: live | cached | redirect
# live = show stored price; cached = show stored price with freshness note;
# redirect = show "See current price on AliExpress"
PUBLIC_PRICE_MODE=cached

# Supabase (optional — site works without it; admin + analytics upgrade when set)
PUBLIC_SUPABASE_URL=
PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# Admin allow-list (comma-separated emails), enforced server-side via Supabase RLS + profiles.role
ADMIN_EMAILS=

# AliExpress Affiliate — OFFICIAL API ONLY (all server-side, never expose to browser)
# Leave empty in mock mode. Fill only when you have approved affiliate access.
ALIPRESS_APP_KEY=
ALIPRESS_APP_SECRET=
ALIPRESS_TRACKING_ID=
ALIPRESS_API_BASE_URL=https://api-sg.aliexpress.com/sync

# Newsletter provider abstraction: database | console (dev) | custom
NEWSLETTER_PROVIDER=database

# Contact inbox: database (default) — wire email provider later
CONTACT_PROVIDER=database
