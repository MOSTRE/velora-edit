---
/* Minimal fashion navigation: SHOP / EDIT / JOURNAL / FOUNDERS + SEARCH / WISHLIST */
---
<div class="announce" slot="announce">
  N°01 — The Everyday Edit · <a href="/edit/new-arrivals">Explore</a>
</div>

<header data-header slot="header">
  <div class="wrap bar">
    <a class="logo" href="/" aria-label="VELORA EDIT home">VELORA EDIT</a>
    <nav class="desk" aria-label="Primary">
      <a class="navlink" href="/jewelry">Shop</a>
      <a class="navlink" href="/edits">Edit</a>
      <a class="navlink" href="/journal">Journal</a>
      <a class="navlink" href="/founders">Founders</a>
    </nav>
    <div class="actions">
      <button class="navlink btn-plain" data-search-open aria-label="Search">Search</button>
      <a class="navlink" href="/wishlist" aria-label="Wishlist">Wishlist</a>
      <button class="iconbtn only-mobile" data-menu-open aria-label="Open menu" aria-expanded="false">☰</button>
    </div>
  </div>
</header>

<div class="fsmenu" data-menu hidden role="dialog" aria-modal="true" aria-label="Menu">
  <div class="wrap fs-top">
    <span class="logo">VELORA EDIT</span>
    <button class="iconbtn" data-menu-close aria-label="Close menu">✕</button>
  </div>
  <nav class="wrap fs-links" aria-label="Mobile">
    <a href="/jewelry">Shop</a>
    <a href="/edits">Edit</a>
    <a href="/journal">Journal</a>
    <a href="/founders">Founders</a>
    <a href="/wishlist">Wishlist</a>
  </nav>
  <p class="wrap tiny muted">Curated jewelry · Nothing excessive.</p>
</div>

<style>
  .bar { display: grid; grid-template-columns: 1fr auto 1fr; align-items: center; height: 72px; gap: 16px; }
  .logo { font-family: var(--serif); font-size: 20px; letter-spacing: 0.3em; font-weight: 600; justify-self: start; }
  .desk { display: flex; gap: 34px; justify-self: center; }
  .actions { display: flex; gap: 26px; align-items: center; justify-self: end; }
  .btn-plain { background: none; border: 0; cursor: pointer; color: inherit; font: inherit; }
  .iconbtn { background: none; border: 0; font-size: 20px; cursor: pointer; padding: 8px; color: inherit; }
  .only-mobile { display: none; }
  .fsmenu { position: fixed; inset: 0; z-index: 400; background: var(--bg); display: flex; flex-direction: column; padding: 0 0 40px; }
  .fsmenu[hidden] { display: none; }
  .fs-top { display: flex; justify-content: space-between; align-items: center; height: 72px; width: 100%; }
  .fs-links { display: grid; gap: 6px; margin-top: 8vh; }
  .fs-links a { font-family: var(--serif); font-size: clamp(40px, 9vw, 72px); line-height: 1.1; transition: opacity 0.25s ease, transform 0.4s var(--ease); }
  .fs-links a:hover { opacity: 0.55; }
  @media (max-width: 900px) {
    .desk, .actions .navlink { display: none; }
    .only-mobile { display: block; }
    .bar { grid-template-columns: 1fr auto; }
    .logo { font-size: 17px; }
    .actions { gap: 8px; }
  }
</style>

<script>
  // @ts-nocheck — browser-only menu script
  (function () {
    var open = document.querySelector('[data-menu-open]');
    var close = document.querySelector('[data-menu-close]');
    var menu = document.querySelector('[data-menu]');
    function show() { menu.removeAttribute('hidden'); document.body.style.overflow = 'hidden'; if (open) open.setAttribute('aria-expanded', 'true'); }
    function hide() { menu.setAttribute('hidden', ''); document.body.style.overflow = ''; if (open) open.setAttribute('aria-expanded', 'false'); }
    if (open) open.addEventListener('click', show);
    if (close) close.addEventListener('click', hide);
    document.addEventListener('keydown', function (e) { if (e.key === 'Escape' && !menu.hasAttribute('hidden')) hide(); });
  })();
</script>
