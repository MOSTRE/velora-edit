---
---
<div class="searchfs" data-search hidden role="dialog" aria-modal="true" aria-label="Search">
  <div class="wrap fs-top">
    <span class="label">Search</span>
    <button class="close" data-search-close aria-label="Close search">✕</button>
  </div>
  <div class="wrap fs-body">
    <input data-search-input type="search" placeholder="Try ‘signet’, ‘gold chain’, ‘hoops’…" aria-label="Search products" autocomplete="off" />
    <div class="fs-cols">
      <div>
        <p class="label">Recent</p>
        <div class="recent" data-search-recent><span class="tiny muted">No recent searches yet.</span></div>
      </div>
      <div>
        <p class="label">Popular edits</p>
        <p class="edits"><a href="/edit/under-20">Under €20</a><a href="/edit/quiet-luxury">Quiet Luxury</a><a href="/edit/new-arrivals">New Arrivals</a><a href="/edit/gold-edit">Gold Edit</a></p>
      </div>
    </div>
    <div data-search-results class="results" aria-live="polite"></div>
  </div>
</div>

<style>
  .searchfs { position: fixed; inset: 0; z-index: 400; background: var(--bg); overflow-y: auto; padding-bottom: 80px; }
  .searchfs[hidden] { display: none; }
  .fs-top { display: flex; justify-content: space-between; align-items: center; height: 72px; }
  .close { background: none; border: 0; font-size: 20px; cursor: pointer; padding: 8px; }
  input[type="search"] {
    width: 100%; font-family: var(--serif); font-size: clamp(34px, 6vw, 72px);
    background: transparent; border: 0; border-bottom: 1px solid var(--ink);
    padding: 8px 0 20px; margin: 4vh 0 40px; border-radius: 0;
  }
  input[type="search"]:focus { outline: none; border-bottom-color: var(--accent); }
  input[type="search"]::placeholder { color: #b9b3a7; }
  .fs-cols { display: grid; grid-template-columns: 1fr 1fr; gap: 40px; margin-bottom: 32px; }
  .recent { display: flex; gap: 18px; flex-wrap: wrap; margin-top: 12px; }
  .recent button { background: none; border: 0; border-bottom: 1px solid var(--line); padding: 2px 0; cursor: pointer; font-size: 14px; color: var(--ink); }
  .edits { display: grid; gap: 8px; margin-top: 12px; }
  .edits a { font-family: var(--serif); font-size: 24px; transition: opacity 0.25s ease; }
  .edits a:hover { opacity: 0.55; }
  .results { display: grid; gap: 0; border-top: 1px solid var(--line); }
  .results a { display: flex; justify-content: space-between; align-items: baseline; gap: 16px; padding: 16px 0; border-bottom: 1px solid var(--line); font-size: 15px; transition: padding-left 0.3s var(--ease); }
  .results a:hover { padding-left: 8px; }
  @media (max-width: 680px) { .fs-cols { grid-template-columns: 1fr; } }
</style>

<script>
  // @ts-nocheck — browser-only search script
  (function () {
    var overlay = document.querySelector('[data-search]');
    var input = document.querySelector('[data-search-input]');
    var results = document.querySelector('[data-search-results]');
    var openers = document.querySelectorAll('[data-search-open]');
    var index = null;
    function open() { overlay.removeAttribute('hidden'); document.body.style.overflow = 'hidden'; input.focus(); }
    function close() { overlay.setAttribute('hidden', ''); document.body.style.overflow = ''; }
    openers.forEach(function (b) { b.addEventListener('click', open); });
    document.querySelector('[data-search-close]').addEventListener('click', close);
    document.addEventListener('keydown', function (e) {
      if ((e.metaKey || e.ctrlKey) && e.key.toLowerCase() === 'k') { e.preventDefault(); open(); }
      if (e.key === 'Escape' && !overlay.hasAttribute('hidden')) close();
    });
    var t;
    input.addEventListener('input', function () { clearTimeout(t); t = setTimeout(function () { run(input.value); }, 180); });
    async function load() {
      if (index) return index;
      var r = await fetch('/search-index.json');
      index = await r.json();
      return index;
    }
    async function run(q) {
      q = (q || '').trim().toLowerCase();
      if (!q) { results.innerHTML = ''; return; }
      results.innerHTML = '<div class="skeleton" aria-hidden="true"></div>';
      var data = await load();
      var words = q.split(/\s+/);
      var hits = data.products.map(function (p) {
        var hay = [p.title, p.category, p.subtitle, p.gender, p.color, p.material, (p.tags || []).join(' '), (p.collection || []).join(' ')].join(' ').toLowerCase();
        var score = 0;
        var ok = words.every(function (w) {
          if (p.title.toLowerCase().indexOf(w) !== -1) { score += 3; return true; }
          if (hay.indexOf(w) !== -1) { score += 1; return true; }
          return false;
        });
        return ok ? { p: p, s: score } : null;
      }).filter(Boolean).sort(function (a, b) { return b.s - a.s; }).slice(0, 10).map(function (x) { return x.p; });
      try {
        var sid = localStorage.getItem('velora-sid') || 'x';
        var arr = JSON.parse(localStorage.getItem('velora-events-v1') || '[]');
        arr.push({ event: 'search', query: q, timestamp: new Date().toISOString(), anonymous_session_id: sid, page_url: location.href });
        localStorage.setItem('velora-events-v1', JSON.stringify(arr.slice(-2000)));
        var recent = JSON.parse(localStorage.getItem('velora-recent-search') || '[]');
        recent = [q].concat(recent.filter(function (x) { return x !== q; })).slice(0, 6);
        localStorage.setItem('velora-recent-search', JSON.stringify(recent));
        paintRecent();
      } catch (e) {}
      if (!hits.length) {
        results.innerHTML = '<p class="serif" style="font-size:28px;margin:24px 0 8px">Nothing matched your search.</p><p class="small muted">Explore the latest edit.</p><p><a class="tlink" href="/edit/new-arrivals">Explore the latest edit →</a></p>';
        return;
      }
      results.innerHTML = hits.map(function (p) {
        var price = p.price != null ? '€' + Number(p.price).toFixed(2) : 'See price';
        return '<a href="/product/' + p.slug + '"><span>' + p.title + ' <small class="muted">' + p.category + '</small></span><span>' + price + '</span></a>';
      }).join('');
    }
    function paintRecent() {
      try {
        var box = document.querySelector('[data-search-recent]');
        if (!box) return;
        var recent = JSON.parse(localStorage.getItem('velora-recent-search') || '[]');
        if (!recent.length) { box.innerHTML = '<span class="tiny muted">No recent searches yet.</span>'; return; }
        box.innerHTML = '';
        recent.forEach(function (q) {
          var b = document.createElement('button');
          b.textContent = q;
          b.addEventListener('click', function () { input.value = q; run(q); input.focus(); });
          box.appendChild(b);
        });
      } catch (e) {}
    }
    paintRecent();
  })();
</script>
