---
import Base from '../layouts/Base.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import SearchOverlay from '../components/SearchOverlay.astro';
import CookieConsent from '../components/CookieConsent.astro';
---
<Base title="About — VELORA EDIT" description="VELORA EDIT is a curated space for jewelry worth noticing." canonical="https://velora-edit.pages.dev/about">
  <Header slot="header" /><Footer slot="footer" />
  <div class="wrap page">
    <p class="eyebrow"><span class="rule"></span>About</p>
    <h1>Curated jewelry worth noticing.</h1>
    <div class="cols">
      <div>
        <p class="lede">VELORA EDIT is a curated space for jewelry worth noticing.</p>
        <p>We discover pieces from online marketplaces — starting with AliExpress — and present them through an editorial lens: proportion, finish, and ease with everything you already own.</p>
        <p>We don't sell, ship, or hold inventory. When you love a piece, we send you to the source through a clearly-marked affiliate link. If you buy there, we may earn a commission at no extra cost to you.</p>
        <p>What we won't do: fake reviews, invented discounts, urgency tricks, or endless catalogue spam. A small edit, updated with intent.</p>
      </div>
      <img src="/images/edit-her.svg" alt="Editorial image — minimal jewelry arch" loading="lazy" width="800" height="600" />
    </div>
  </div>
  <SearchOverlay /><CookieConsent />
</Base>
<style>
  .page{padding:48px 24px 72px;max-width:1000px}
  h1{font-size:clamp(40px,6vw,72px);margin:8px 0 24px}
  .lede{font-family:var(--serif);font-size:24px}
  .cols{display:grid;grid-template-columns:1.2fr 1fr;gap:40px;align-items:start}
  img{width:100%;border:1px solid var(--line)}
  @media(max-width:820px){.cols{grid-template-columns:1fr}}
</style>
