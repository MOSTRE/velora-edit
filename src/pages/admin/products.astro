---
import Base from '../../layouts/Base.astro';
import { getPublishedProducts } from '../../lib/store';
const products = getPublishedProducts();
const json = JSON.stringify(products.map((p) => ({ id: p.id, slug: p.slug, title: p.title, price: p.price, status: p.status, affiliate: p.affiliate_url, score: p.editorial_score })));
---
<Base title="Admin · Products — VELORA EDIT" noindex={true}>
  <div class="wrap admin">
    <p class="eyebrow">Admin · Products</p>
    <h1>Products.</h1>
    <nav class="tabs"><a href="/admin">Dashboard</a><a href="/admin/products">Products</a><a href="/admin/affiliate-links">Affiliate Links</a><a href="/admin/import">Import</a><a href="/admin/analytics">Analytics</a><a href="/admin/founders">Founders</a><a href="/admin/settings">Settings</a></nav>
    <div class="toolbar">
      <input data-q type="search" placeholder="Filter by title, slug, category…" aria-label="Filter products" />
      <button class="btn btn-ghost" data-export>Export JSON</button>
      <button class="btn" data-new>New product</button>
    </div>
    <p class="tiny muted">Preview before publishing. Local edits save as drafts on this device — export JSON and commit to publish (production: Supabase).</p>
    <table class="table"><thead><tr><th>Title</th><th>Price</th><th>Status</th><th>Score</th><th>Affiliate</th><th></th></tr></thead><tbody data-rows></tbody></table>

    <dialog data-editor>
      <form method="dialog" data-form>
        <h2 data-etitle>Product</h2>
        <div class="grid">
          <div class="field"><label>Title</label><input name="title" required minlength="3" /></div>
          <div class="field"><label>Slug</label><input name="slug" required /></div>
          <div class="field"><label>Price (EUR)</label><input name="price" type="number" step="0.01" min="0" /></div>
          <div class="field"><label>Category</label><select name="category"><option>rings</option><option>necklaces</option><option>bracelets</option><option>earrings</option><option>chains</option></select></div>
          <div class="field"><label>Affiliate URL (required to publish)</label><input name="affiliate_url" type="url" placeholder="https://…" /></div>
          <div class="field"><label>Image URL</label><input name="image" /></div>
          <div class="field"><label>Material (only if verified)</label><input name="material" /></div>
          <div class="field"><label>Status</label><select name="status"><option>DRAFT</option><option>REVIEW</option><option>PUBLISHED</option><option>ARCHIVED</option></select></div>
        </div>
        <div class="field"><label>Description (min 40 chars)</label><textarea name="description" rows="3"></textarea></div>
        <div class="field"><label>Editor note</label><textarea name="editor_note" rows="2"></textarea></div>
        <div class="checks">
          <label><input type="checkbox" name="is_featured" /> Featured</label>
          <label><input type="checkbox" name="editor_pick" /> Editor's pick</label>
          <label><input type="checkbox" name="is_best_value" /> Best value</label>
          <label><input type="checkbox" name="is_new" /> New</label>
        </div>
        <p class="small" data-ewarn role="status"></p>
        <div class="row"><button class="btn" value="save">Save draft</button><button class="btn btn-ghost" value="cancel" formnovalidate>Close</button></div>
      </form>
    </dialog>
  </div>
  <script define:vars={{ json }}>
    // @ts-nocheck — browser-only product manager
    (function () {
      if (sessionStorage.getItem('velora-admin') !== '1') location.href = '/admin';
      var seed = JSON.parse(json);
      function overrides() { try { return JSON.parse(localStorage.getItem('velora-drafts') || '{}'); } catch (e) { return {}; } }
      function all() {
        var o = overrides();
        var map = {};
        seed.forEach(function (p) { map[p.slug] = { ...p, ...(o[p.slug] || {}) }; });
        Object.keys(o).forEach(function (k) { if (!map[k]) map[k] = o[k]; });
        return Object.values(map);
      }
      var rows = document.querySelector('[data-rows]');
      var q = document.querySelector('[data-q]');
      function draw() {
        var term = (q.value || '').toLowerCase();
        rows.innerHTML = all().filter(function (p) {
          return (p.title + p.slug).toLowerCase().includes(term);
        }).map(function (p) {
          var ok = !!p.affiliate;
          return '<tr><td><strong>' + p.title + '</strong><br><small class="muted">' + p.slug + '</small></td><td>€' + Number(p.price || 0).toFixed(2) + '</td><td>' + p.status + '</td><td>' + (p.score ?? '—') + '</td><td>' + (ok ? '✓' : '<b style="color:#a33">missing — cannot publish</b>') + '</td><td><button data-edit="' + p.slug + '">Edit</button></td></tr>';
        }).join('');
      }
      q.addEventListener('input', draw); draw();
      var dlg = document.querySelector('[data-editor]');
      var form = document.querySelector('[data-form]');
      var current = null;
      rows.addEventListener('click', function (e) {
        var b = e.target.closest('[data-edit]'); if (!b) return;
        var p = all().find(function (x) { return x.slug === b.getAttribute('data-edit'); });
        current = p.slug;
        form.title.value = p.title || ''; form.slug.value = p.slug || '';
        form.price.value = p.price ?? ''; form.affiliate_url.value = p.affiliate || '';
        form.description.value = ''; form.editor_note.value = '';
        document.querySelector('[data-ewarn]').textContent = p.affiliate ? '' : 'No affiliate URL — this product stays DRAFT/unpublished until one is set.';
        dlg.showModal();
      });
      document.querySelector('[data-new]').addEventListener('click', function () {
        current = 'new-' + Date.now();
        form.reset(); dlg.showModal();
      });
      form.addEventListener('submit', function () {
        if (document.activeElement && document.activeElement.value === 'cancel') return;
        var o = overrides();
        o[form.slug.value || current] = {
          slug: form.slug.value || current, title: form.title.value,
          price: Number(form.price.value) || null, status: form.status.value,
          affiliate: form.affiliate_url.value, id: form.slug.value,
        };
        localStorage.setItem('velora-drafts', JSON.stringify(o)); draw();
      });
      document.querySelector('[data-export]').addEventListener('click', function () {
        var blob = new Blob([localStorage.getItem('velora-drafts') || '{}'], { type: 'application/json' });
        var a = document.createElement('a');
        a.href = URL.createObjectURL(blob); a.download = 'velora-drafts.json'; a.click();
      });
    })();
  </script>
</Base>
<style>
  .admin{padding:48px 24px 72px;max-width:1100px}h1{font-size:clamp(36px,5vw,56px)}
  .tabs{display:flex;gap:16px;flex-wrap:wrap;margin:20px 0;font-size:13px;font-weight:600}
  .toolbar{display:flex;gap:8px;margin:16px 0;flex-wrap:wrap}
  .toolbar input{flex:1;min-width:220px;border:1px solid var(--line);padding:12px;font:inherit;background:#fff}
  dialog{border:1px solid var(--line);padding:24px;max-width:640px;width:calc(100vw - 32px)}
  .grid{display:grid;grid-template-columns:1fr 1fr;gap:10px}
  .checks{display:flex;gap:14px;flex-wrap:wrap;font-size:14px;margin:8px 0}
  .row{display:flex;gap:8px;margin-top:12px}
  @media(max-width:640px){.grid{grid-template-columns:1fr}}
</style>
