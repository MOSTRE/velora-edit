---
import Base from '../../layouts/Base.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import CollectionGrid from '../../components/CollectionGrid.astro';
import SearchOverlay from '../../components/SearchOverlay.astro';
import CookieConsent from '../../components/CookieConsent.astro';
import Newsletter from '../../components/Newsletter.astro';
import { getByCollection, getCollection } from '../../lib/store';
import { collectionImage } from '../../lib/images';
import { COLLECTIONS } from '../../lib/types';

export async function getStaticPaths() {
  return COLLECTIONS.map((c) => ({ params: { slug: c.slug } }));
}
const { slug } = Astro.params;
const collection = getCollection(slug as string);
if (!collection) return Astro.redirect('/404');
const products = getByCollection(collection.slug);
const num = String(COLLECTIONS.findIndex((c) => c.slug === collection.slug) + 1).padStart(2, '0');
const art = collectionImage(collection.slug, 2000);
---
<Base
  title={`${collection.title} — VELORA EDIT`}
  description={collection.description}
  canonical={`https://velora-edit.pages.dev/edit/${collection.slug}`}
  ogImage={art.url}
>
  <Header slot="header" />
  <Footer slot="footer" />

  <section class="cover">
    <div class="cover-media" aria-hidden="true">
      <img src={art.url} alt="" width="2000" height="1200" loading="eager" decoding="async" data-parallax="0.08" />
    </div>
    <div class="wrap cover-copy">
      <p class="label light reveal">The Edit / {num} · {products.length} pieces</p>
      <h1 class="display reveal">{collection.title}</h1>
      <p class="serif standfirst reveal reveal-d1">{collection.description}</p>
    </div>
  </section>

  <section class="wrap intro">
    <p class="story-text reveal">{collection.editorial}</p>
    <p class="caption">Photography: {art.credit} (temporary placeholder imagery).</p>
  </section>

  <section class="section-tight">
    <div class="wrap">
      {products.length === 0 ? (
        <p>This edit is being restyled — <a href="/edits">browse all edits</a>.</p>
      ) : (
        <CollectionGrid products={products} pageSize={12} />
      )}
    </div>
  </section>
  <Newsletter />
  <SearchOverlay />
  <CookieConsent />
</Base>
<script>
  // @ts-nocheck — browser-only analytics snippet
  try {
    var arr = JSON.parse(localStorage.getItem('velora-events-v1') || '[]');
    arr.push({ event: 'collection_view', collection: location.pathname, timestamp: new Date().toISOString(), anonymous_session_id: localStorage.getItem('velora-sid') || 'x', page_url: location.href });
    localStorage.setItem('velora-events-v1', JSON.stringify(arr.slice(-2000)));
  } catch (e) {}
</script>
<style>
  .cover { position: relative; min-height: 78vh; display: flex; align-items: flex-end; overflow: hidden; background: #0b0b0b; }
  .cover-media { position: absolute; inset: -6% 0; }
  .cover-media img { width: 100%; height: 100%; object-fit: cover; }
  .cover::after { content: ""; position: absolute; inset: 0; background: linear-gradient(to top, rgba(5,5,5,0.6), transparent 60%); }
  .cover-copy { position: relative; z-index: 2; padding-bottom: 10vh; color: #fff; }
  .cover-copy h1 { color: #fff; text-transform: uppercase; }
  .standfirst { font-size: clamp(20px, 2.6vw, 30px); font-style: italic; color: #e9e2d4; margin-top: 12px; max-width: 640px; }
  .label.light { color: #d9d0c3; }
  .intro { max-width: 760px; padding: 64px 32px 8px; }
  .story-text { font-family: var(--serif); font-size: 24px; line-height: 1.5; }
</style>
