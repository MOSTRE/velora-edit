---
import Base from '../../layouts/Base.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import CollectionGrid from '../../components/CollectionGrid.astro';
import SearchOverlay from '../../components/SearchOverlay.astro';
import CookieConsent from '../../components/CookieConsent.astro';
import Newsletter from '../../components/Newsletter.astro';
import { getByCollection, getCollection } from '../../lib/store';
import { COLLECTIONS } from '../../lib/types';

export async function getStaticPaths() {
  return COLLECTIONS.map((c) => ({ params: { slug: c.slug } }));
}
const { slug } = Astro.params;
const collection = getCollection(slug as string);
if (!collection) return Astro.redirect('/404');
const products = getByCollection(collection.slug);
---
<Base
  title={`${collection.title} — VELORA EDIT`}
  description={collection.description}
  canonical={`https://velora-edit.pages.dev/edit/${collection.slug}`}
  ogImage={collection.image}
>
  <Header slot="header" />
  <Footer slot="footer" />
  <section class="wrap chead">
    <p class="eyebrow reveal"><span class="rule"></span>The Edit · N°{String(COLLECTIONS.findIndex((c) => c.slug === collection.slug) + 1).padStart(2, '0')} · {products.length} pieces</p>
    <h1 class="reveal">{collection.title}</h1>
    <p class="serif sub reveal reveal-d1">{collection.description}</p>
  </section>
  <div class="wrap"><img class="cover reveal" src={collection.image} alt={collection.title} width="1600" height="700" loading="eager" decoding="async" data-parallax="0.05" /></div>
  <section class="wrap story">
    <hr class="hr-gold" />
    <p class="story-text reveal">{collection.editorial}</p>
    <p class="caption">The {collection.title} edit — {products.length} pieces, updated as new finds land.</p>
  </section>
  <section class="section-tight">
    <div class="wrap">
      {products.length === 0 ? (
        <p>This edit is being restyled — <a href="/edits">browse all edits</a>.</p>
      ) : (
        <CollectionGrid products={products} pageSize={12} />
      )}
    </div>
  </section>
  <Newsletter />
  <SearchOverlay />
  <CookieConsent />
</Base>
<script>
  // @ts-nocheck — browser-only analytics snippet
  try {
    var arr = JSON.parse(localStorage.getItem('velora-events-v1') || '[]');
    arr.push({ event: 'collection_view', collection: location.pathname, timestamp: new Date().toISOString(), anonymous_session_id: localStorage.getItem('velora-sid') || 'x', page_url: location.href });
    localStorage.setItem('velora-events-v1', JSON.stringify(arr.slice(-2000)));
  } catch (e) {}
</script>
<style>
  .chead { padding: 56px 24px 8px; max-width: 1000px; }
  h1 { font-size: clamp(46px, 7vw, 92px); margin: 10px 0; }
  .sub { font-size: clamp(20px, 2.6vw, 28px); font-style: italic; color: #3a352e; }
  .cover { width: 100%; height: auto; max-height: 520px; object-fit: cover; margin: 28px 0 8px; border: 1px solid var(--line); }
  .story { max-width: 760px; padding: 32px 24px 8px; }
  .story-text { font-family: var(--serif); font-size: 22px; line-height: 1.5; margin: 20px 0 8px; }
</style>
