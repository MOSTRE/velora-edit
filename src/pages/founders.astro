---
import Base from '../layouts/Base.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import SearchOverlay from '../components/SearchOverlay.astro';
import CookieConsent from '../components/CookieConsent.astro';
import Newsletter from '../components/Newsletter.astro';
import { getFounders } from '../lib/store';
import { editorialImage } from '../lib/images';

const founders = getFounders();
const [first, second] = founders;
const sanaeImg = editorialImage('founder-sanae', 1400);
const salmaImg = editorialImage('founder-salma', 1400);
---
<Base
  title="Founders — The people behind the edit | VELORA EDIT"
  description="Two perspectives. One shared obsession with beautiful details. Meet Sanae and Salma, the founders of VELORA EDIT."
  canonical="https://velora-edit.pages.dev/founders"
  ogImage={sanaeImg.url}
>
  <Header slot="header" />
  <Footer slot="footer" />

  <section class="wrap fhero">
    <p class="label reveal"><span class="rule"></span>The Founders</p>
    <h1 class="h-xl reveal">The people<br />behind the edit.</h1>
  </section>

  {first && (
    <section class="section-tight">
      <div class="wrap full reveal img-zoom">
        <img src={sanaeImg.url} alt={sanaeImg.alt} width="1400" height="933" loading="eager" decoding="async" />
      </div>
      <div class="wrap prof">
        <div class="reveal">
          <p class="label">01 — {first.role}</p>
          <h2 class="h-lg">{first.name}</h2>
        </div>
        <div class="reveal reveal-d1">
          <p class="bio">{first.bio}</p>
          <p class="serif quote">“{first.quote}”</p>
          <p class="caption">Atelier detail, temporary placeholder imagery ({sanaeImg.credit}). Founder photography to be supplied.</p>
        </div>
      </div>
    </section>
  )}

  {second && (
    <section class="section-tight dark">
      <div class="wrap full reveal img-zoom">
        <img src={salmaImg.url} alt={salmaImg.alt} width="1400" height="933" loading="lazy" decoding="async" />
      </div>
      <div class="wrap prof reverse">
        <div class="reveal reveal-d1">
          <p class="bio">{second.bio}</p>
          <p class="serif quote">“{second.quote}”</p>
          <p class="caption dim">Atelier detail, temporary placeholder imagery ({salmaImg.credit}). Founder photography to be supplied.</p>
        </div>
        <div class="reveal">
          <p class="label light">02 — {second.role}</p>
          <h2 class="h-lg">{second.name}</h2>
        </div>
      </div>
    </section>
  )}

  <section class="finale">
    <div class="wrap reveal">
      <p class="label"><span class="rule"></span>Why we exist</p>
      <p class="serif final-line">VELORA EDIT was created to make discovering jewelry feel personal again.</p>
      <p><a class="tlink" href="/edits">Explore the edit →</a></p>
    </div>
  </section>

  <Newsletter />
  <SearchOverlay />
  <CookieConsent />
</Base>

<style>
  .fhero { padding: 96px 32px 48px; }
  .fhero h1 { margin-top: 16px; }
  .full img { width: 100%; aspect-ratio: 3/2; object-fit: cover; }
  .prof { display: grid; grid-template-columns: 40fr 60fr; gap: 64px; margin-top: 48px; align-items: start; }
  .prof.reverse { grid-template-columns: 60fr 40fr; }
  .prof h2 { letter-spacing: 0.12em; margin-top: 12px; }
  .bio { font-size: 18px; line-height: 1.7; max-width: 560px; }
  .quote { font-size: clamp(24px, 3vw, 34px); font-style: italic; margin: 28px 0 12px; }
  .dark { background: #0b0b0b; color: #f5f3ee; }
  .dark .bio { color: #cfc9bd; }
  .label.light { color: #a8a29a; }
  .caption.dim { color: #8d867a; }
  .finale { padding: 120px 0; text-align: center; }
  .final-line { font-size: clamp(28px, 4vw, 52px); max-width: 860px; margin: 16px auto 32px; }
  @media (max-width: 860px) {
    .prof, .prof.reverse { grid-template-columns: 1fr; gap: 28px; }
    .full img { aspect-ratio: 4/3; }
  }
</style>
