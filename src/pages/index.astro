---
import Base from '../layouts/Base.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import ProductCard from '../components/ProductCard.astro';
import SearchOverlay from '../components/SearchOverlay.astro';
import Newsletter from '../components/Newsletter.astro';
import CookieConsent from '../components/CookieConsent.astro';
import { getPublishedProducts, getArticles, getFounders } from '../lib/store';
import { editorialImage } from '../lib/images';
import { orgJsonLd } from '../lib/seo';

const products = getPublishedProducts();
const featured = products.filter((p) => p.is_featured).slice(0, 6);
const picks = products.filter((p) => p.editor_pick).slice(0, 6);
const articles = getArticles().slice(0, 3);
const founders = getFounders();
const hero = editorialImage('hero', 2000);
const campaign = editorialImage('campaign', 1600);
const detail = editorialImage('detail', 1600);
const [lead, ...rest] = articles;
---
<Base
  title="VELORA EDIT — Jewelry Worth Discovering"
  description="Curated pieces for a quieter kind of luxury. New arrivals, the signature edit, founders' notes and journal guides."
  canonical="https://velora-edit.pages.dev/"
  ogImage={hero.url}
  jsonLd={[orgJsonLd()]}
>
  <link slot="head" rel="preload" as="image" href={hero.url} fetchpriority="high" />
  <Header slot="header" />
  <Footer slot="footer" />

  <!-- 01 · HERO -->
  <section class="hero">
    <div class="hero-media" aria-hidden="true">
      <img src={hero.url} alt="" width="2000" height="1333" fetchpriority="high" decoding="async" data-parallax="0.1" />
    </div>
    <div class="wrap hero-copy">
      <p class="label light reveal">N°01 — The Everyday Edit</p>
      <h1 class="display reveal">Jewelry that<br />stays with you.</h1>
      <p class="reveal reveal-d1"><a class="tlink light" href="/edits">Explore the edit →</a></p>
    </div>
  </section>

  <!-- 02 · FEATURED CAMPAIGN -->
  <section class="section">
    <div class="wrap campaign">
      <div class="camp-media img-zoom reveal">
        <img src={campaign.url} alt={campaign.alt} width="1600" height="1067" loading="eager" decoding="async" />
      </div>
      <div class="camp-copy reveal reveal-d1">
        <p class="label"><span class="rule"></span>The New Edit</p>
        <h2 class="h-lg">Pieces selected for proportion, texture and the way they change in motion.</h2>
        <p><a class="tlink" href="/edit/new-arrivals">Discover →</a></p>
        <p class="caption">Photography: {campaign.credit} (temporary placeholder imagery).</p>
      </div>
    </div>
  </section>

  <!-- 03 · SHOP THE EDIT -->
  <section class="section-tight">
    <div class="wrap">
      <div class="sechead reveal">
        <p class="label"><span class="rule"></span>Shop the edit</p>
        <h2 class="h-xl">The Edit</h2>
        <p class="muted lede">A small selection worth stopping for.</p>
      </div>
      <div class="grid-asym">
        {featured.map((p, i) => <ProductCard product={p} index={i} />)}
      </div>
    </div>
  </section>

  <!-- 04 · EDITORIAL STORY -->
  <section class="section story">
    <div class="wrap story-grid">
      <div class="reveal">
        <p class="label"><span class="rule"></span>The Detail</p>
        <h2 class="h-lg">Luxury is a clasp that closes cleanly.</h2>
        <p class="muted body">We look closely at the parts nobody photographs: the hinge, the edge, the weight of a link. If the detail is right, the piece earns its place.</p>
        <p><a class="tlink" href="/journal/affordable-look-expensive">Read the guide →</a></p>
      </div>
      <div class="img-zoom reveal reveal-d1">
        <img src={detail.url} alt={detail.alt} width="1600" height="1067" loading="lazy" decoding="async" data-parallax="0.05" />
        <p class="caption">Photography: {detail.credit} (temporary placeholder imagery).</p>
      </div>
    </div>
  </section>

  <!-- 05 · CURATED PRODUCTS -->
  <section class="section-tight">
    <div class="wrap">
      <div class="sechead reveal">
        <p class="label"><span class="rule"></span>Curated</p>
        <h2 class="h-xl">Editor's picks</h2>
      </div>
      <div class="grid-products">
        {picks.map((p, i) => <ProductCard product={p} index={i} />)}
      </div>
      <p class="more-row reveal"><a class="tlink" href="/edit/quiet-luxury">Quiet Luxury →</a> <a class="tlink" href="/edit/for-her">For Her →</a></p>
    </div>
  </section>

  <!-- 06 · FOUNDERS (compact) -->
  <section class="section founders">
    <div class="wrap f-grid">
      <div class="f-collage reveal">
        {founders.map((f) => (
          <img src={(f.id === 'sanae' ? editorialImage('founder-sanae', 800) : editorialImage('founder-salma', 800)).url} alt={`Atelier detail — portrait placeholder for ${f.name}`} width="800" height="1000" loading="lazy" decoding="async" />
        ))}
      </div>
      <div class="reveal reveal-d1">
        <p class="label"><span class="rule"></span>The Founders</p>
        <h2 class="h-lg">Two perspectives. One edit.</h2>
        <p class="muted body">Sanae and Salma built VELORA EDIT around considered, personal pieces — without the noise.</p>
        <p><a class="tlink" href="/founders">Meet Sanae & Salma →</a></p>
      </div>
    </div>
  </section>

  <!-- 07 · JOURNAL -->
  <section class="section-tight">
    <div class="wrap">
      <div class="sechead reveal">
        <p class="label"><span class="rule"></span>Journal</p>
        <h2 class="h-xl">Notes</h2>
      </div>
      {lead && (
        <a class="j-lead reveal" href={`/journal/${lead.slug}`}>
          <div class="card-img"><img src={lead.image} alt={lead.title} loading="lazy" width="1600" height="900" /></div>
          <div class="j-lead-body">
            <p class="tiny muted">{lead.read_minutes} min read</p>
            <h3 class="h-md">{lead.title}</h3>
            <p class="muted">{lead.excerpt}</p>
          </div>
        </a>
      )}
      <div class="grid-2 j-rest">
        {rest.map((a) => (
          <a class="card reveal" href={`/journal/${a.slug}`}>
            <div class="card-img" style="aspect-ratio:16/10"><img src={a.image} alt={a.title} loading="lazy" width="800" height="500" /></div>
            <div style="padding:18px 0"><p class="tiny muted">{a.read_minutes} min read</p><h3 class="serif" style="font-size:24px;margin:6px 0">{a.title}</h3></div>
          </a>
        ))}
      </div>
      <p class="more-row reveal"><a class="tlink" href="/journal">View journal →</a></p>
    </div>
  </section>

  <Newsletter />
  <SearchOverlay />
  <CookieConsent />
</Base>

<style>
  .hero { position: relative; min-height: 92vh; display: flex; align-items: flex-end; overflow: hidden; background: #0b0b0b; }
  .hero-media { position: absolute; inset: -6% 0; }
  .hero-media img { width: 100%; height: 100%; object-fit: cover; }
  .hero::after { content: ""; position: absolute; inset: 0; background: linear-gradient(to top, rgba(5,5,5,0.55), transparent 55%); }
  .hero-copy { position: relative; z-index: 2; padding-bottom: 12vh; color: #fff; }
  .hero-copy .display { color: #fff; }
  .label.light { color: #d9d0c3; }
  .campaign { display: grid; grid-template-columns: 65fr 35fr; gap: 64px; align-items: end; }
  .camp-media img { width: 100%; height: auto; aspect-ratio: 4/3; object-fit: cover; }
  .camp-copy h2 { margin: 16px 0 28px; }
  .sechead { margin-bottom: 56px; max-width: 720px; }
  .sechead h2 { margin: 14px 0 10px; }
  .lede { font-family: var(--serif); font-size: 22px; font-style: italic; }
  .story { background: #fff; border-top: 1px solid var(--line); border-bottom: 1px solid var(--line); }
  .story-grid { display: grid; grid-template-columns: 35fr 65fr; gap: 64px; align-items: center; }
  .story-grid img { width: 100%; aspect-ratio: 4/3; object-fit: cover; }
  .body { font-size: 17px; max-width: 420px; }
  .more-row { display: flex; gap: 32px; margin-top: 48px; flex-wrap: wrap; }
  .founders { background: #0b0b0b; color: #f5f3ee; }
  .founders .muted { color: #a8a29a; }
  .founders .tlink { color: #fff; border-color: #fff; }
  .f-grid { display: grid; grid-template-columns: 55fr 45fr; gap: 64px; align-items: center; }
  .f-collage { display: grid; grid-template-columns: 1fr 1fr; gap: 16px; }
  .f-collage img { width: 100%; aspect-ratio: 3/4; object-fit: cover; }
  .f-collage img:last-child { margin-top: 48px; }
  .j-lead { display: grid; grid-template-columns: 60fr 40fr; gap: 48px; align-items: center; margin-bottom: 64px; }
  .j-lead .card-img { aspect-ratio: 16/10; }
  @media (max-width: 900px) {
    .hero { min-height: 86vh; }
    .campaign, .story-grid, .f-grid, .j-lead { grid-template-columns: 1fr; gap: 32px; }
    .f-collage img:last-child { margin-top: 0; }
  }
</style>
