---
import Base from '../../layouts/Base.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import CollectionGrid from '../../components/CollectionGrid.astro';
import SearchOverlay from '../../components/SearchOverlay.astro';
import CookieConsent from '../../components/CookieConsent.astro';
import { getByCategory } from '../../lib/store';
import { CATEGORIES } from '../../lib/types';

export async function getStaticPaths() {
  return CATEGORIES.map((c) => ({ params: { category: c.slug } }));
}
const { category } = Astro.params;
const meta = CATEGORIES.find((c) => c.slug === category);
if (!meta) return Astro.redirect('/404');
const products = getByCategory(category as string);
---
<Base title={`${meta.title} — VELORA EDIT`} description={meta.description} canonical={`https://velora-edit.pages.dev/jewelry/${meta.slug}`}>
  <Header slot="header" /><Footer slot="footer" />
  <div class="wrap page">
    <p class="eyebrow reveal"><span class="rule"></span>Jewelry · {products.length} pieces</p>
    <h1 class="reveal">{meta.title}.</h1>
    <p class="muted reveal">{meta.description} Filter by wearer, set a price ceiling, or sort — the grid updates instantly.</p>
    <hr class="hr-gold" />
    {products.length === 0 ? <p>This piece hasn't made it into the edit yet.</p> : <CollectionGrid products={products} pageSize={12} />}
  </div>
  <SearchOverlay /><CookieConsent />
</Base>
<style>
  .page{padding:56px 24px 72px}h1{font-size:clamp(46px,7vw,88px);margin:10px 0 8px}
</style>
