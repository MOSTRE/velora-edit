---
import Base from '../layouts/Base.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import ProductCard from '../components/ProductCard.astro';
import SearchOverlay from '../components/SearchOverlay.astro';
import CookieConsent from '../components/CookieConsent.astro';
import { getPublishedProducts } from '../lib/store';
const fresh = getPublishedProducts().filter((p) => p.is_new);
---
<Base title="New In — VELORA EDIT" description="The latest additions to the edit." canonical="https://velora-edit.pages.dev/new">
  <Header slot="header" /><Footer slot="footer" />
  <div class="wrap page">
    <p class="eyebrow"><span class="rule"></span>New In</p>
    <h1>New finds.</h1>
    <div class="grid-products">{fresh.map((p) => <ProductCard product={p} />)}</div>
  </div>
  <SearchOverlay /><CookieConsent />
</Base>
<style>.page{padding:48px 24px 72px}h1{font-size:clamp(42px,6vw,76px);margin:8px 0 24px}</style>
