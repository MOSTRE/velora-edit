---
import Base from '../../layouts/Base.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import ProductCard from '../../components/ProductCard.astro';
import SearchOverlay from '../../components/SearchOverlay.astro';
import CookieConsent from '../../components/CookieConsent.astro';
import { getPublishedProducts, getProductBySlug, getRelated } from '../../lib/store';
import { formatPrice } from '../../lib/types';
import { productJsonLd, breadcrumbJsonLd } from '../../lib/seo';

export async function getStaticPaths() {
  return getPublishedProducts().map((p) => ({ params: { slug: p.slug } }));
}

const { slug } = Astro.params;
const product = getProductBySlug(slug as string);

if (!product || !(product.affiliate_url || product.source_url)) {
  return Astro.redirect('/404');
}

const related = getRelated(product, 4);
const priceMode = (import.meta.env.PUBLIC_PRICE_MODE as string) || 'cached';
const showPrice = product.price != null && priceMode !== 'redirect';
// Outbound destination: approved affiliate URL when available, otherwise the
// verified source URL — clearly marked pending affiliate conversion.
const outboundUrl = product.affiliate_url || product.source_url || '#';
const affiliateLive = Boolean(product.affiliate_url && product.affiliate_verified !== false);
const isMock = (product.affiliate_url || '').includes('example.com');
const flag = product.is_limited ? 'Limited edit' : product.is_new ? 'New' : product.editor_pick ? "Editor's pick" : product.is_best_value ? 'Best value' : '';
---
<Base
  title={product.seo_title || `${product.title} — VELORA EDIT`}
  description={product.seo_description || product.description}
  canonical={`https://velora-edit.pages.dev/product/${product.slug}`}
  ogImage={product.og_image || product.thumbnail_url}
  jsonLd={[productJsonLd(product), breadcrumbJsonLd([{ name: 'Home', url: '/' }, { name: product.category, url: `/jewelry/${product.category}` }, { name: product.title, url: `/product/${product.slug}` }])]}
>
  <Header slot="header" />
  <Footer slot="footer" />

  <div class="wrap crumb tiny muted">
    <a href="/">Home</a> / <a href="/jewelry">Shop</a> / <a href={`/jewelry/${product.category}`}>{product.category}</a>
  </div>

  <div class="wrap pdp">
    <div class="gallery">
      <div class="stage img-zoom">
        <div class="carousel" data-carousel>
          {product.image_urls.map((u, i) => (
            <img class="slide" src={u} alt={i === 0 ? product.title : `${product.title} — detail view`} width="800" height="1040" fetchpriority={i === 0 ? 'high' : 'auto'} loading={i === 0 ? 'eager' : 'lazy'} decoding="async" />
          ))}
        </div>
        <button class="zoom" data-zoom-open aria-label="Zoom product image">+</button>
      </div>
      <div class="thumbs" data-thumbs>
        {product.image_urls.map((u, i) => (
          <button data-thumb={i} aria-label={`View image ${i + 1}`} aria-pressed={i === 0 ? 'true' : 'false'}>
            <img src={u} alt="" aria-hidden="true" loading="lazy" width="200" height="260" />
          </button>
        ))}
      </div>
      <p class="caption">N°{product.id.replace('seed-', '').replace('ali-', '')} — {product.demo ? 'studio placeholder imagery for development.' : 'retailer-supplied imagery.'}</p>
    </div>

    <div class="info">
      <div class="sticky">
        <p class="label"><span class="rule"></span>Product · {product.category}</p>
        <h1 class="h-xl">{product.title}</h1>
        {flag && <p class="pcard-flag">{flag}</p>}
        <p class="price big">{showPrice ? formatPrice(product) : 'See current price on AliExpress'}</p>
        <p class="tiny muted">See current price & availability on AliExpress</p>
        <p class="desc">{product.description}</p>
        <div class="editor">
          <p class="serif note">“{product.editor_note}”</p>
        </div>
        <a
          class="btn btn-gold big-cta"
          href={outboundUrl}
          target="_blank"
          rel={affiliateLive ? 'sponsored noopener' : 'noopener'}
          data-affiliate-click={product.id}
          data-affiliate-url={outboundUrl}
          data-pending={!affiliateLive ? 'true' : undefined}
        >Shop on AliExpress →</a>
        {affiliateLive ? (
          <p class="tiny muted">Affiliate disclosure: this link may earn VELORA EDIT a commission at no additional cost to you.</p>
        ) : (
          <p class="tiny pending">Direct retailer link — affiliate conversion pending. This shopping link is the verified source page; VELORA EDIT earns no commission on it yet. <a href="/affiliate-disclosure">Learn more</a>.</p>
        )}
        {isMock && <p class="tiny mock">Mock affiliate destination — development link, not a real person's link.</p>}
        <p><button class="tlink" data-wish={product.id} data-wish-label="Save" aria-pressed="false">♡ Save to wishlist</button></p>
        <hr class="hr-quiet" />
        <details open>
          <summary>Details</summary>
          <ul class="small muted">
            {product.material && <li>Materials: {product.material}</li>}
            {product.color && <li>Finish: {product.color}-tone</li>}
            <li>Worn by: {product.gender}</li>
          </ul>
        </details>
        <details>
          <summary>Shipping information</summary>
          <p class="small muted">VELORA EDIT does not sell or fulfill products. Shipping, returns and support are handled by AliExpress — check current terms on the source page before ordering.</p>
        </details>
      </div>
    </div>
  </div>

  <dialog class="zoomdlg" data-zoom>
    <img src={product.image_urls[0]} alt={product.title} width="1200" height="1560" />
    <button class="zoom-close" data-zoom-close aria-label="Close zoom">✕ Close</button>
  </dialog>

  {related.length > 0 && (
    <section class="section-tight">
      <div class="wrap">
        <div class="sechead"><p class="label"><span class="rule"></span>Related</p><h2 class="h-lg">Pairs well with.</h2></div>
        <div class="grid-products">{related.map((p, i) => <ProductCard product={p} index={i} />)}</div>
      </div>
    </section>
  )}

  <SearchOverlay />
  <CookieConsent />
</Base>

<script>
  // @ts-nocheck — browser-only gallery / zoom / analytics script
  (function () {
    var slides = Array.prototype.slice.call(document.querySelectorAll('[data-carousel] .slide'));
    var thumbs = Array.prototype.slice.call(document.querySelectorAll('[data-thumb]'));
    function show(i) {
      slides.forEach(function (s, j) { s.style.display = j === i ? '' : 'none'; });
      thumbs.forEach(function (b, j) { b.setAttribute('aria-pressed', j === i ? 'true' : 'false'); });
    }
    thumbs.forEach(function (b, i) { b.addEventListener('click', function () { show(i); }); });
    var dlg = document.querySelector('[data-zoom]');
    var openBtn = document.querySelector('[data-zoom-open]');
    if (openBtn && dlg && dlg.showModal) openBtn.addEventListener('click', function () { dlg.showModal(); });
    var closeBtn = document.querySelector('[data-zoom-close]');
    if (closeBtn && dlg) closeBtn.addEventListener('click', function () { dlg.close(); });
    if (window.matchMedia('(max-width: 900px)').matches) {
      slides.forEach(function (s) { s.style.display = ''; });
      var car = document.querySelector('[data-carousel]');
      if (car) car.addEventListener('scroll', function () {
        var i = Math.round(car.scrollLeft / (car.clientWidth || 1));
        thumbs.forEach(function (b, j) { b.setAttribute('aria-pressed', j === i ? 'true' : 'false'); });
      }, { passive: true });
    } else { show(0); }
    try {
      var arr = JSON.parse(localStorage.getItem('velora-events-v1') || '[]');
      arr.push({ event: 'product_view', product_id: document.querySelector('[data-affiliate-click]')?.getAttribute('data-affiliate-click'), timestamp: new Date().toISOString(), anonymous_session_id: localStorage.getItem('velora-sid') || 'x', page_url: location.href, referrer: document.referrer || undefined });
      localStorage.setItem('velora-events-v1', JSON.stringify(arr.slice(-2000)));
    } catch (e) {}
    document.querySelectorAll('[data-affiliate-click]').forEach(function (a) {
      a.addEventListener('click', function () {
        try {
          var arr2 = JSON.parse(localStorage.getItem('velora-events-v1') || '[]');
          arr2.push({ event: 'affiliate_click', product_id: a.getAttribute('data-affiliate-click'), timestamp: new Date().toISOString(), anonymous_session_id: localStorage.getItem('velora-sid') || 'x', page_url: location.href });
          localStorage.setItem('velora-events-v1', JSON.stringify(arr2.slice(-2000)));
        } catch (e) {}
      });
    });
  })();
</script>

<style>
  .crumb { padding: 28px 32px 0; }
  .crumb a { text-decoration: underline; text-underline-offset: 3px; }
  .pdp { display: grid; grid-template-columns: 58fr 42fr; gap: 72px; padding: 24px 32px 96px; align-items: start; }
  .stage { position: relative; }
  .carousel { display: grid; background: var(--neutral); }
  .carousel .slide { grid-area: 1 / 1; width: 100%; aspect-ratio: 3/4; object-fit: cover; }
  .zoom { position: absolute; right: 16px; bottom: 16px; width: 44px; height: 44px; border-radius: 50%; border: 1px solid var(--line); background: rgba(255,255,255,0.92); font-size: 20px; cursor: pointer; }
  .thumbs { display: flex; gap: 12px; margin-top: 12px; }
  .thumbs button { border: 0; border-bottom: 2px solid transparent; background: none; padding: 0 0 6px; cursor: pointer; width: 72px; opacity: 0.55; transition: opacity 0.2s ease; }
  .thumbs button[aria-pressed="true"] { opacity: 1; border-bottom-color: var(--ink); }
  .thumbs img { width: 100%; aspect-ratio: 3/4; object-fit: cover; }
  .sticky { position: sticky; top: 104px; }
  h1 { margin: 14px 0 6px; }
  .big { font-size: 22px; margin: 18px 0 2px; }
  .desc { font-size: 17px; margin: 22px 0; max-width: 44ch; }
  .editor { border-left: 1px solid var(--accent); padding-left: 20px; margin: 28px 0; }
  .note { font-size: 24px; font-style: italic; line-height: 1.4; }
  .big-cta { width: 100%; padding: 20px; font-size: 13px; margin-top: 8px; }
  .mock { background: #fff7e6; border: 1px solid #e8d9ae; padding: 8px 10px; }
  .pending { background: #f4efe4; border: 1px solid var(--line); padding: 10px 12px; }
  .pending a { text-decoration: underline; text-underline-offset: 3px; }
  .tlink { background: none; border: 0; border-bottom: 1px solid var(--ink); cursor: pointer; font: inherit; }
  details { border-top: 1px solid var(--line); padding: 16px 0; }
  summary { cursor: pointer; font-size: 12px; letter-spacing: 0.16em; text-transform: uppercase; font-weight: 500; }
  .zoomdlg { border: 0; padding: 0; background: #0b0b0b; max-width: 90vw; }
  .zoomdlg::backdrop { background: rgba(5,5,5,0.85); }
  .zoomdlg img { width: min(80vw, 640px); height: auto; }
  .zoom-close { position: sticky; bottom: 16px; margin: 12px; background: #fff; border: 0; padding: 10px 18px; cursor: pointer; font-size: 12px; letter-spacing: 0.16em; text-transform: uppercase; }
  @media (max-width: 900px) {
    .pdp { grid-template-columns: 1fr; gap: 32px; }
    .sticky { position: static; }
    .carousel { display: flex; overflow-x: auto; scroll-snap-type: x mandatory; scrollbar-width: none; }
    .carousel::-webkit-scrollbar { display: none; }
    .carousel .slide { flex: 0 0 100%; scroll-snap-align: start; }
    .zoom { display: none; }
  }
</style>
